---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
const { title, description, current, structuredData } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#171716"/><meta name="description" content={description}/><meta name="robots" content="index, follow, max-image-preview:large"/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/><title>{title}</title><ClientRouter />{structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}</head>
<body><a class="skip-link" href="#content">Skip to content</a><Header current={current}/><main id="content"><slot /></main><Footer />
<script is:inline data-astro-rerun>
  const root = document.documentElement;
  const cartCount = document.querySelector('[data-cart-count]');
  const applyRegion = (region) => { root.dataset.region = region; localStorage.setItem('tamakala-region', region); document.querySelectorAll('[data-region-label]').forEach((el) => el.textContent = region === 'nepal' ? 'NPR' : 'USD'); };
  const savedRegion = localStorage.getItem('tamakala-region');
  applyRegion(savedRegion || (navigator.languages.some((language) => language.toLowerCase().startsWith('ne')) ? 'nepal' : 'international'));
  const menu = document.querySelector('[data-region-menu]'); const toggle = document.querySelector('[data-region-toggle]');
  if (menu && toggle) {
    toggle.addEventListener('click', () => { const open = menu.hidden; menu.hidden = !open; toggle.setAttribute('aria-expanded', String(open)); });
    document.querySelectorAll('[data-region]').forEach((button) => button.addEventListener('click', () => { applyRegion(button.dataset.region || 'nepal'); menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); }));
  }
  const count = Number(localStorage.getItem('tamakala-cart') || 0); if (cartCount) cartCount.textContent = String(count);
  document.querySelectorAll('[data-add-to-cart]').forEach((button) => button.addEventListener('click', () => { const next = Number(localStorage.getItem('tamakala-cart') || 0) + 1; localStorage.setItem('tamakala-cart', String(next)); if (cartCount) cartCount.textContent = String(next); button.textContent = 'Added to bag'; setTimeout(() => button.textContent = 'Add to bag', 1400); }));
  const motionObserver = new IntersectionObserver((entries) => entries.forEach((entry) => entry.target.toggleAttribute('data-in-view', entry.isIntersecting)), { threshold: 0.12 });
  document.querySelectorAll('[data-marquee]').forEach((element) => motionObserver.observe(element));
  document.querySelectorAll('[data-reveal]').forEach((element) => motionObserver.observe(element));
</script></body></html>
