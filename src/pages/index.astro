---
import BaseLayout from '../layouts/BaseLayout.astro';
import { productData } from '../data/catalog';
import { Image } from 'astro:assets';
const product = productData;
---
<BaseLayout title="Tamakala — Ancient Element. Future Form." description="The Monolith Vessel: a hand-finished copper vessel made in South Asia." current="/">
  <section class="relative min-h-[calc(100svh-4rem)] overflow-hidden bg-ink text-white">
    <Image src={product.images.heroStill} format="webp" quality={86} widths={[768, 1280, 1600, 1952]} sizes="100vw" alt="The Monolith Vessel with hand-finished copper cups in a dark stone setting" class="hero-still absolute inset-0 size-full" fetchpriority="high" loading="eager" decoding="async" />
    <div class="hero-shade absolute inset-0"></div><div class="hero-grain absolute inset-0"></div><div class="hero-orbit hidden lg:block" aria-hidden="true"><span class="hero-orbit-dot"></span></div><div class="absolute bottom-[11%] right-[-5%] hidden overflow-hidden lg:block" aria-hidden="true"><span class="hero-word">copper</span></div><div class="page-pad relative flex min-h-[calc(100svh-4rem)] items-end pb-14 pt-32"><div class="content-grid w-full"><p class="eyebrow reveal text-copper">South Asia · Origin collection</p><h1 class="display reveal reveal-delay mt-5 max-w-3xl text-6xl sm:text-7xl lg:text-9xl">Ancient element.<br/><em class="text-copper">Future form.</em></h1><div class="reveal mt-9 flex flex-wrap items-center gap-5"><a class="action-light" href="/shop">Meet the vessel</a><span class="text-xs tracking-[.12em] text-white/65">Pure copper · Hand-finished</span></div></div></div>
  </section>
  <section class="overflow-hidden bg-copper py-5 text-ink" data-marquee aria-label="Tamakala qualities"><div class="marquee-track" aria-hidden="true"><span>Pure copper <b>✦</b> Hand-finished <b>✦</b> Made in South Asia <b>✦</b> Pure copper <b>✦</b> Hand-finished <b>✦</b> Made in South Asia <b>✦</b></span><span>Pure copper <b>✦</b> Hand-finished <b>✦</b> Made in South Asia <b>✦</b> Pure copper <b>✦</b> Hand-finished <b>✦</b> Made in South Asia <b>✦</b></span></div></section>
  <section class="bg-paper py-20 page-pad lg:py-32"><div class="content-grid grid items-center gap-12 lg:grid-cols-2"><div data-reveal><p class="eyebrow text-copper-dark">01 · The object</p><h2 class="display mt-5 text-5xl sm:text-6xl">Made to hold<br/>the moment.</h2><p class="mt-7 max-w-md text-base leading-7 text-ink/70">The Monolith Vessel brings an elemental material into a contemporary ritual. Each surface keeps the quiet evidence of its making.</p><a class="action-dark mt-9" href="/products/the-monolith-vessel">View product</a></div><div data-reveal="scale" style="--reveal-delay: 100ms" class="bg-[#ded6ca] p-8 lg:p-14"><Image class="product-tilt mx-auto max-h-[38rem] w-auto" src={product.images.product} format="webp" quality={82} widths={[480, 768, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" alt="Full view of The Monolith Vessel" loading="lazy" /></div></div></section>
  <section class="grid bg-carbon text-white lg:grid-cols-2"><div data-reveal="scale" class="image-frame"><Image src={product.images.heritage} format="webp" quality={82} widths={[480, 768, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" alt="An artisan's copper workshop in South Asia" class="h-full min-h-[28rem] w-full object-cover" loading="lazy"/></div><div class="flex items-center page-pad py-20 lg:py-32"><div data-reveal style="--reveal-delay: 110ms" class="max-w-xl"><p class="eyebrow text-copper">02 · The hand</p><h2 class="display mt-5 text-5xl sm:text-6xl">A record of<br/><em>making.</em></h2><p class="mt-7 max-w-lg leading-7 text-white/65">Tamakala is shaped by the long lineage of copper craft in South Asia. We leave the material present—not concealed—so every piece can carry its own character.</p><a class="action-light mt-9" href="/journal">Read our journal</a></div></div></section>
  <section class="page-pad bg-patina py-20 text-white lg:py-28"><div class="content-grid flex flex-col gap-10 md:flex-row md:items-end md:justify-between"><div><p class="eyebrow text-[#d7c7aa]">Delivery, considered</p><h2 class="display mt-5 text-5xl">From workshop<br/>to your door.</h2></div><div class="grid gap-5 text-sm leading-6 text-white/75 md:max-w-md"><p>Domestic and international prices are set for where you are shopping. Change your region at any time from the menu.</p><a class="action-light w-fit" href="/track-order">Track an order</a></div></div></section>
</BaseLayout>
