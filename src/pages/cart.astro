---
import BaseLayout from '../layouts/BaseLayout.astro'; import { Image } from 'astro:assets'; import { productData as p } from '../data/catalog';
---
<BaseLayout title="Your bag | Tamakala" description="Review your Tamakala bag." current="">
  <section class="page-pad py-16 lg:py-24"><div class="content-grid max-w-5xl"><p class="eyebrow text-copper-dark">Your bag</p><h1 class="display mt-4 text-5xl">The object,<br/><em>almost yours.</em></h1><div class="mt-12 grid gap-10 lg:grid-cols-[1fr_20rem]"><div class="border-y border-ink/15 py-6"><div class="flex gap-5"><Image src={p.images.product} format="webp" quality={80} widths={[256]} sizes="112px" alt="The Monolith Vessel" class="size-28 bg-[#d8cdbd] object-contain" loading="eager"/><div><p class="eyebrow text-copper-dark">{p.sku}</p><h2 class="mt-2 font-serif text-2xl">The Monolith Vessel</h2><p class="price mt-3"><span data-price="npr">{p.price.npr}</span><span data-price="usd">{p.price.usd}</span></p><button class="mt-4 text-xs underline underline-offset-4">Remove</button></div></div></div><aside class="h-fit bg-ink p-6 text-white"><p class="eyebrow text-copper">Order summary</p><div class="mt-6 flex justify-between text-sm"><span>Subtotal</span><span class="price"><span data-price="npr">{p.price.npr}</span><span data-price="usd">{p.price.usd}</span></span></div><p class="mt-5 text-xs leading-5 text-white/60">Shipping and payment methods are confirmed in checkout for your region.</p><a href="/checkout" class="action-light mt-7 w-full">Continue to checkout</a></aside></div></div></section>
</BaseLayout>
