---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getImage, Image } from 'astro:assets'; import { productData, faqs } from '../../data/catalog'; const p = productData;
const schemaImage = await getImage({ src: p.images.hero, format: 'webp', width: 1200, quality: 86 });
const structuredData = { '@context':'https://schema.org', '@type':'Product', name:p.name, description:p.description, sku:p.sku, brand:{'@type':'Brand',name:'Tamakala'}, image:[new URL(schemaImage.src, Astro.site).href], offers:{'@type':'Offer', availability:'https://schema.org/InStock', price:'100', priceCurrency:'USD', url:'https://www.tamakala.store/products/the-monolith-vessel'} };
---
<BaseLayout title="The Monolith Vessel | Tamakala" description={p.description} current="/shop" structuredData={structuredData}>
  <section class="page-pad bg-paper py-8 lg:py-12"><div class="content-grid grid gap-10 lg:grid-cols-[1.15fr_.85fr]"><div class="grid gap-4 sm:grid-cols-2"><div class="col-span-full bg-[#d8cdbd] p-8 lg:p-14"><Image class="mx-auto max-h-[43rem] w-auto" src={p.images.hero} format="webp" quality={86} widths={[768, 1200, 1600]} sizes="(min-width: 1024px) 58vw, 100vw" alt="The Monolith Vessel, hand-finished pure copper" loading="eager" fetchpriority="high" decoding="async"/></div><Image src={p.images.detail} format="webp" quality={82} widths={[480, 768, 1024]} sizes="(min-width: 640px) 29vw, 100vw" alt="Close-up of the copper surface texture" class="aspect-square size-full object-cover" loading="lazy"/><Image src={p.images.gallery} format="webp" quality={82} widths={[480, 768, 1024]} sizes="(min-width: 640px) 29vw, 100vw" alt="The Monolith Vessel photographed in profile" class="aspect-square size-full object-cover" loading="lazy"/></div><div class="lg:sticky lg:top-24 lg:h-fit"><p class="eyebrow text-copper-dark">{p.sku} · Origin collection</p><h1 class="display mt-5 text-5xl sm:text-6xl">The Monolith<br/>Vessel</h1><p class="price mt-6 font-serif text-2xl"><span data-price="npr">{p.price.npr}</span><span data-price="usd">{p.price.usd}</span></p><p class="mt-2 text-[10px] font-semibold tracking-[.15em] text-ink/45 uppercase">Pricing for <span data-region-label>NPR</span></p><p class="mt-8 max-w-lg leading-7 text-ink/70">{p.description} Its substantial silhouette and softly changing surface make it as much an object to live with as it is a vessel to use.</p><div class="mt-8 grid grid-cols-2 gap-3 border-y border-ink/15 py-5 text-sm"><span>Material</span><span class="text-ink/60">Pure copper</span><span>Finish</span><span class="text-ink/60">Hand-finished</span><span>Origin</span><span class="text-ink/60">South Asia</span></div><button class="action-dark mt-8 w-full" data-add-to-cart type="button">Add to bag</button><p class="mt-3 text-center text-xs leading-5 text-ink/55">Payment options appear at checkout based on your delivery region.</p></div></div></section>
  <section class="page-pad bg-carbon py-20 text-white lg:py-28"><div class="content-grid grid gap-12 lg:grid-cols-2"><h2 class="display text-5xl">Made for<br/><em>the daily ritual.</em></h2><div class="space-y-5 leading-7 text-white/65"><p>Uncoated copper changes with time. The marks and warmth that develop are part of the material’s life.</p><p>For care and routine maintenance, use warm water and a soft cloth; keep the vessel dry between uses.</p></div></div></section>
  <section class="page-pad py-20 lg:py-28"><div class="content-grid max-w-4xl"><p class="eyebrow text-copper-dark">Questions</p><h2 class="display mt-4 text-5xl">Before it arrives.</h2><div class="mt-10 border-t border-ink/15">{faqs.slice(0,3).map(([q,a]) => <details class="border-b border-ink/15 py-5"><summary class="flex cursor-pointer items-center justify-between gap-6 text-base font-medium">{q}<svg class="size-4 shrink-0 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 5v14M5 12h14"/></svg></summary><p class="max-w-2xl pt-4 leading-7 text-ink/65">{a}</p></details>)}</div><a href="/faq" class="action-dark mt-8">See all questions</a></div></section>
</BaseLayout>
