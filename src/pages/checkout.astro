---
import BaseLayout from '../layouts/BaseLayout.astro'; import { Image } from 'astro:assets'; import { productData as p } from '../data/catalog';
---
<BaseLayout title="Checkout | Tamakala" description="Checkout for The Monolith Vessel." current="">
  <section class="page-pad py-12 lg:py-20"><div class="content-grid grid gap-12 lg:grid-cols-[1fr_22rem]"><div><p class="eyebrow text-copper-dark">Secure checkout</p><h1 class="display mt-4 text-5xl">Delivery details.</h1><form class="mt-10 grid gap-5"><div class="grid gap-5 sm:grid-cols-2"><label class="text-xs font-semibold tracking-[.1em] uppercase">First name<input name="given-name" autocomplete="given-name" class="mt-2 min-h-12 w-full border border-ink/25 bg-white px-3 normal-case tracking-normal outline-none focus:border-copper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-copper" required/></label><label class="text-xs font-semibold tracking-[.1em] uppercase">Last name<input name="family-name" autocomplete="family-name" class="mt-2 min-h-12 w-full border border-ink/25 bg-white px-3 normal-case tracking-normal outline-none focus:border-copper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-copper" required/></label></div><label class="text-xs font-semibold tracking-[.1em] uppercase">Email<input type="email" name="email" autocomplete="email" spellcheck="false" class="mt-2 min-h-12 w-full border border-ink/25 bg-white px-3 normal-case tracking-normal outline-none focus:border-copper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-copper" required/></label><label class="text-xs font-semibold tracking-[.1em] uppercase">Delivery country<select name="country" autocomplete="country-name" class="mt-2 min-h-12 w-full border border-ink/25 bg-white px-3 normal-case tracking-normal outline-none focus:border-copper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-copper"><option>Nepal</option><option>International</option></select></label><div class="border-t border-ink/15 pt-6"><p class="eyebrow text-copper-dark">Payment</p><p class="mt-3 text-sm leading-6 text-ink/60">Available payment options will be routed by final shipping region: eSewa, Khalti, and Fonepay for Nepal; Stripe, PayPal, Apple Pay, and bank transfer internationally.</p></div><button class="action-dark w-fit" type="button">Continue to payment</button></form></div><aside class="h-fit bg-[#ded6ca] p-6"><p class="eyebrow text-copper-dark">Your order</p><Image src={p.images.product} format="webp" quality={80} widths={[480]} sizes="208px" alt="The Monolith Vessel" class="mx-auto mt-5 h-52 w-auto object-contain" loading="eager"/><h2 class="font-serif text-2xl">The Monolith Vessel</h2><p class="price mt-3"><span data-price="npr">{p.price.npr}</span><span data-price="usd">{p.price.usd}</span></p></aside></div></section>
</BaseLayout>
