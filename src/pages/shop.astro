---
import BaseLayout from '../layouts/BaseLayout.astro'; import { Image } from 'astro:assets'; import { productData } from '../data/catalog'; const product = productData;
---
<BaseLayout title="Shop copper vessels | Tamakala" description="Shop The Monolith Vessel, a hand-finished pure copper vessel." current="/shop">
  <section class="page-pad bg-ink py-20 text-white lg:py-28"><div class="content-grid"><p class="eyebrow text-copper">Origin collection · 001</p><h1 class="display mt-5 text-6xl sm:text-7xl">Objects with<br/><em>gravity.</em></h1><p class="mt-7 max-w-lg leading-7 text-white/65">Our first collection is intentionally small. One vessel, considered in every detail.</p></div></section>
  <section class="page-pad py-12 lg:py-20"><div class="content-grid grid gap-9 md:grid-cols-2"><a class="group bg-[#ddd3c4] p-7 lg:p-12" href="/products/the-monolith-vessel"><Image class="product-tilt mx-auto h-[28rem] w-auto object-contain" src={product.images.product} format="webp" quality={82} widths={[480, 768, 1024]} sizes="(min-width: 768px) 50vw, 100vw" alt="The Monolith Vessel in copper" loading="eager" /></a><div class="flex flex-col justify-center"><p class="eyebrow text-copper-dark">{product.sku}</p><h2 class="display mt-4 text-5xl">The Monolith<br/>Vessel</h2><p class="mt-6 max-w-md leading-7 text-ink/70">Pure copper. Hand-finished in South Asia. A daily vessel shaped to stay in use for years.</p><p class="price mt-7 font-serif text-2xl"><span data-price="npr">{product.price.npr}</span><span data-price="usd">{product.price.usd}</span></p><p class="mt-2 text-[10px] font-semibold tracking-[.15em] text-ink/45 uppercase">Pricing for <span data-region-label>NPR</span></p><div class="mt-8 flex flex-wrap gap-3"><a class="action-dark" href="/products/the-monolith-vessel">View details</a><button class="action border-ink hover:border-copper" data-add-to-cart type="button">Add to bag</button></div></div></div></section>
</BaseLayout>
