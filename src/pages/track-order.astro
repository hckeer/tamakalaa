---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Track your Tamakala order" description="Follow your Tamakala order from the workshop to delivery." current="/track-order">
  <section class="page-pad bg-carbon py-20 text-white lg:py-28"><div class="content-grid"><p class="eyebrow text-copper">Order journey</p><h1 class="display mt-5 text-6xl sm:text-7xl">Follow the<br/><em>making.</em></h1></div></section>
  <section class="page-pad py-16 lg:py-24"><div class="content-grid grid gap-14 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow text-copper-dark">A more personal delivery</p><h2 class="display mt-4 text-5xl">Your vessel has a story before it ships.</h2><p class="mt-6 leading-7 text-ink/65">Enter the reference from your confirmation email to see the latest workshop or delivery update.</p></div><form class="border border-ink/15 bg-white p-7 sm:p-10" data-track-form><label class="eyebrow text-ink/55" for="order">Order reference or email</label><input id="order" name="order" autocomplete="off" spellcheck="false" required class="mt-3 min-h-12 w-full border border-ink/30 bg-paper px-4 outline-none focus:border-copper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-copper" placeholder="e.g. TK-2026-001…"/><button class="action-dark mt-5 w-full" type="submit">Find my order</button><p data-track-result class="mt-5 text-sm leading-6 text-ink/60" aria-live="polite">Your tracking details are private and will appear here after validation.</p></form></div></section>
  <script is:inline data-astro-rerun>const form = document.querySelector('[data-track-form]'); const result = document.querySelector('[data-track-result]'); form?.addEventListener('submit', (event) => { event.preventDefault(); if (result) result.textContent = 'Tracking will connect to your order service once the backend is live. Your reference has not been stored.'; });</script>
</BaseLayout>
