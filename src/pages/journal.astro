---
import BaseLayout from '../layouts/BaseLayout.astro'; import { Image } from 'astro:assets'; import { productData } from '../data/catalog'; const p=productData;
---
<BaseLayout title="The Tamakala Journal" description="Notes on copper, care, and the craft of considered objects." current="/journal">
  <section class="page-pad bg-paper py-20 lg:py-28"><div class="content-grid"><p class="eyebrow text-copper-dark">Journal</p><h1 class="display mt-5 max-w-3xl text-6xl sm:text-7xl">A material with<br/><em>a memory.</em></h1></div></section>
  <section class="page-pad pb-20"><div class="content-grid grid gap-8 lg:grid-cols-2"><article class="bg-ink text-white"><Image src={p.images.journal} format="webp" quality={82} widths={[480, 768, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" alt="Copper vessel in an atmospheric setting" class="h-80 w-full object-cover" loading="lazy"/><div class="p-8"><p class="eyebrow text-copper">Material notes · 6 min read</p><h2 class="display mt-4 text-4xl">Why copper changes—and why we let it.</h2><p class="mt-5 leading-7 text-white/65">A living finish rewards care, and tells the truth about use.</p><a class="action-light mt-7" href="/faq">Read the care notes</a></div></article><article class="bg-[#d8cdbd]"><Image src={p.images.heritage} format="webp" quality={82} widths={[480, 768, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" alt="Tamakala's craft heritage" class="h-80 w-full object-cover" loading="lazy"/><div class="p-8"><p class="eyebrow text-copper-dark">From the workshop · 4 min read</p><h2 class="display mt-4 text-4xl">The hand is still in the object.</h2><p class="mt-5 leading-7 text-ink/65">The small evidence of skilled making is what makes every vessel individual.</p><a class="action-dark mt-7" href="/products/the-monolith-vessel">Meet the vessel</a></div></article></div></section>
</BaseLayout>
